diff --git a/test/unit/leapdb.c b/test/unit/leapdb.c
new file mode 100644
index 00000000..509fc394
--- /dev/null
+++ b/test/unit/leapdb.c
@@ -0,0 +1,104 @@
+/*
+ **********************************************************************
+ * Copyright (C) Patrick Oppenlander 2023
+ *
